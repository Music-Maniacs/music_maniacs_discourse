<div class="recording-card">
  <img class="cover-art" src="{{this.recording.cover_art_url}}" alt="{{this.recording.name}} Cover Art" />
  <div class="recording-info">
    <h3 class="recording-name">{{this.recording.name}}</h3>
    <p class="recording-duration">{{format-track-length this.recording.length}}</p>
  </div>
</div>
