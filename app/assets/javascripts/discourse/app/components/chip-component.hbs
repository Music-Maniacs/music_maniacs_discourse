<div class="chip-container">
  <div class="chip post-rock">
    <div class="chip-content">
      <span class="chip-text">post-rock</span>
      <span class="chip-separator"></span>
      <span class="chip-count">1</span>
    </div>
    <div class="chip-controls">
      <button class="control-btn add" onclick="incrementCount(this)">+</button>
      <button class="control-btn remove" onclick="decrementCount(this)">-</button>
    </div>
  </div>
</div>
