<div class="container popular-tracks">
  <div class="heading">
    <h2>Popular tracks</h2>
    <DButton 
      @class="play-all-btn" 
      @icon="play"
      @label="Play all"
      @action={{this.playAll}} />
  </div>
  {{#if this.recordings}}
    <ul class="track-list">
      {{#each this.recordings as |recording|}}
        <RecordingItem 
          @recording={{recording}}
          @onPlay={{this.playTrack}}
          @onFavorite={{this.toggleFavorite}}
          @onAdd={{this.addToPlaylist}}
          @onMore={{this.showMoreOptions}} />
      {{/each}}
    </ul>
  {{else}}
    <p>Loading recordings...</p>
  {{/if}}
</div>