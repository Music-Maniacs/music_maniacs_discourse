		select distinct recording_id from (SELECT
			-- *,
		    recordings.id as recording_id,
			CASE
				WHEN RELEASE_GROUP_META.FIRST_RELEASE_DATE_YEAR IS NOT NULL
				AND RELEASE_GROUP_META.FIRST_RELEASE_DATE_MONTH IS NOT NULL
				AND RELEASE_GROUP_META.FIRST_RELEASE_DATE_DAY IS NOT NULL THEN MAKE_DATE(
					RELEASE_GROUP_META.FIRST_RELEASE_DATE_YEAR,
					RELEASE_GROUP_META.FIRST_RELEASE_DATE_MONTH,
					RELEASE_GROUP_META.FIRST_RELEASE_DATE_DAY
				)
				WHEN RELEASE_GROUP_META.FIRST_RELEASE_DATE_YEAR IS NOT NULL
				AND RELEASE_GROUP_META.FIRST_RELEASE_DATE_MONTH IS NOT NULL THEN MAKE_DATE(
					RELEASE_GROUP_META.FIRST_RELEASE_DATE_YEAR,
					RELEASE_GROUP_META.FIRST_RELEASE_DATE_MONTH,
					1
				)
				WHEN RELEASE_GROUP_META.FIRST_RELEASE_DATE_YEAR IS NOT NULL THEN MAKE_DATE(RELEASE_GROUP_META.FIRST_RELEASE_DATE_YEAR, 1, 1)
			END AS FIRST_RELEASE_DATE,
			ROW_NUMBER() OVER (
				PARTITION BY
					RECORDINGS.ID
				ORDER BY
					RELEASE_GROUP_META.FIRST_RELEASE_DATE_YEAR NULLS LAST,
					RELEASE_GROUP_META.FIRST_RELEASE_DATE_MONTH NULLS LAST,
					RELEASE_GROUP_META.FIRST_RELEASE_DATE_DAY NULLS LAST
			) AS RN
		FROM
			RECORDING RECORDINGS
			JOIN RECORDING_META RECORDING_META ON RECORDING_META.ID = RECORDINGS.ID
			JOIN TRACK TRACKS ON TRACKS.RECORDING = RECORDINGS.ID
			JOIN MEDIUM MEDIUMS ON MEDIUMS.ID = TRACKS.MEDIUM
			JOIN RELEASE RELEASES ON RELEASES.ID = MEDIUMS.RELEASE
			JOIN RELEASE_GROUP RELEASE_GROUPS ON RELEASE_GROUPS.ID = RELEASES.RELEASE_GROUP
			JOIN RELEASE_GROUP_META RELEASE_GROUP_META ON RELEASE_GROUP_META.ID = RELEASE_GROUPS.ID
			JOIN ARTIST_CREDIT_NAME ARTIST_CREDIT_NAMES ON ARTIST_CREDIT_NAMES.ARTIST_CREDIT = RECORDINGS.ARTIST_CREDIT
		WHERE
			(ARTIST_CREDIT_NAMES.ARTIST = '12299')
)
where rn = 1 and first_release_date is not null