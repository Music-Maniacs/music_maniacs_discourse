SELECT
	REC.ID AS RECORDING_ID,
	ACN.ARTIST,
	MIN(
		CASE
			WHEN RGM.FIRST_RELEASE_DATE_MONTH IS NOT NULL
			AND RGM.FIRST_RELEASE_DATE_DAY IS NOT NULL THEN MAKE_DATE(
				RGM.FIRST_RELEASE_DATE_YEAR,
				RGM.FIRST_RELEASE_DATE_MONTH,
				RGM.FIRST_RELEASE_DATE_DAY
			)
			WHEN RGM.FIRST_RELEASE_DATE_MONTH IS NOT NULL THEN MAKE_DATE(
				RGM.FIRST_RELEASE_DATE_YEAR,
				RGM.FIRST_RELEASE_DATE_MONTH,
				1
			)
			WHEN RGM.FIRST_RELEASE_DATE_YEAR IS NOT NULL THEN MAKE_DATE(RGM.FIRST_RELEASE_DATE_YEAR, 1, 1)
		END
	) AS FIRST_RELEASE_DATE
FROM
	RECORDING REC
	JOIN TRACK T ON T.RECORDING = REC.ID
	JOIN MEDIUM M ON M.ID = T.MEDIUM
	JOIN RELEASE R ON R.ID = M.RELEASE
	JOIN RELEASE_GROUP RG ON RG.ID = R.RELEASE_GROUP
	JOIN RELEASE_GROUP_META RGM ON RGM.ID = RG.ID
	JOIN ARTIST_CREDIT_NAME ACN ON ACN.ARTIST_CREDIT = REC.ARTIST_CREDIT
WHERE
	RGM.FIRST_RELEASE_DATE_YEAR IS NOT NULL
GROUP BY
	REC.ID,
	ACN.ARTIST