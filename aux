WITH
	RECORDINGS_FIRST_RELEASE_DATE AS (
		SELECT
			REC.ID AS RECORDING_ID,
			ACN.ARTIST_CREDIT AS ARTIST_CREDIT,
			MIN(
				CASE
					WHEN RGM.FIRST_RELEASE_DATE_MONTH IS NOT NULL
					AND RGM.FIRST_RELEASE_DATE_DAY IS NOT NULL THEN MAKE_DATE(
						RGM.FIRST_RELEASE_DATE_YEAR,
						RGM.FIRST_RELEASE_DATE_MONTH,
						RGM.FIRST_RELEASE_DATE_DAY
					)
					WHEN RGM.FIRST_RELEASE_DATE_MONTH IS NOT NULL THEN MAKE_DATE(
						RGM.FIRST_RELEASE_DATE_YEAR,
						RGM.FIRST_RELEASE_DATE_MONTH,
						1
					)
					WHEN RGM.FIRST_RELEASE_DATE_YEAR IS NOT NULL THEN MAKE_DATE(RGM.FIRST_RELEASE_DATE_YEAR, 1, 1)
				END
			) AS FIRST_RELEASE_DATE
		FROM
			RECORDING REC
			JOIN TRACK T ON T.RECORDING = REC.ID
			JOIN MEDIUM M ON M.ID = T.MEDIUM
			JOIN RELEASE R ON R.ID = M.RELEASE
			JOIN RELEASE_GROUP RG ON RG.ID = R.RELEASE_GROUP
			JOIN RELEASE_GROUP_META RGM ON RGM.ID = RG.ID
			JOIN ARTIST_CREDIT_NAME ACN ON ACN.ARTIST_CREDIT = REC.ARTIST_CREDIT
		WHERE
			-- RGM.FIRST_RELEASE_DATE_YEAR IS NOT NULL
			RGM.FIRST_RELEASE_DATE_YEAR IS NOT NULL
			AND ACN.ARTIST = 12299
		GROUP BY
			REC.ID,
			ACN.ARTIST_CREDIT
	)
SELECT
	* 
FROM
	"recording"
	JOIN RECORDING_META RECORDING_META ON RECORDING_META.ID = RECORDING.ID
	JOIN TRACK TRACKS ON TRACKS.RECORDING = RECORDING.ID
	JOIN MEDIUM MEDIUMS ON MEDIUMS.ID = TRACKS.MEDIUM
	JOIN RELEASE RELEASES ON RELEASES.ID = MEDIUMS.RELEASE
	JOIN RELEASE_GROUP RELEASE_GROUPS ON RELEASE_GROUPS.ID = RELEASES.RELEASE_GROUP
	JOIN RELEASE_GROUP_META RELEASE_GROUP_META ON RELEASE_GROUP_META.ID = RELEASE_GROUPS.ID
	INNER JOIN "artist_credit_name" ON "recording"."artist_credit" = "artist_credit_name"."artist_credit"
	inner join RECORDINGS_FIRST_RELEASE_DATE on RECORDINGS_FIRST_RELEASE_DATE.RECORDING_ID = recording.id
WHERE
	"artist_credit_name"."artist" = 12299